# Copy to deploy/.env.production on the deployment host; keep that file private.
# Every REPLACE_ value is a placeholder, not a usable credential.
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
APP_NAME=Private Stage
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

# Fresh installs: fill unique private values locally. Existing-data migrations
# must retain the matching session/encryption keys from the protected backup.
SESSION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_WITH_DISCORD_CLIENT_SECRET
DISCORD_GUILD_ID=REPLACE_WITH_DISCORD_SERVER_ID
DISCORD_OWNER_ID=REPLACE_WITH_DISCORD_OWNER_USER_ID
DISCORD_ADMIN_ROLE_IDS=

# Match these values to the keys map in private livekit.production.yaml.
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET_AT_LEAST_32_CHARACTERS
MEMBERSHIP_CACHE_SECONDS=60
MEMBERSHIP_RECHECK_SECONDS=60
MEMBERSHIP_MAX_STALE_SECONDS=300
