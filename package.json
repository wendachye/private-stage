{
  "name": "private-stage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "tsx watch backend/src/index.ts",
    "start": "tsx backend/src/index.ts",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace frontend && npm run typecheck --workspace backend",
    "test": "tsx --test tests/*.test.ts",
    "test:media": "tsx --test tests/media*.test.ts",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@livekit/rtc-node": "1.2.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ]
}
