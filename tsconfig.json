{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./frontend/*"
      ]
    },
    "incremental": true,
    "allowJs": true,
    "isolatedModules": true
  },
  "include": [
    "frontend/app",
    "frontend/client",
    "frontend/components",
    "frontend/lib",
    "frontend/proxy.ts",
    "frontend/next-env.d.ts",
    "backend/src",
    "shared",
    "tests",
    "frontend/.next/types/**/*.ts",
    "frontend/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
