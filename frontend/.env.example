# Public backend origin for independent frontend hosting, for example:
# NEXT_PUBLIC_API_URL=https://api.example.com
# Leave empty for the combined local desktop address at http://localhost:3210.
# This value is included in browser code. Never put credentials or secrets here.
NEXT_PUBLIC_API_URL=
# Optional same-origin gateway mode. These two values are SERVER-ONLY.
# Leave both empty for the combined desktop app or direct API hosting.
BACKEND_ORIGIN=
BACKEND_PROXY_SECRET=
