# Run npm run setup to generate .env with unique local keys.
APP_NAME=Private Stage
HOST=127.0.0.1
PORT=3210
APP_URL=http://localhost:3210
# When hosting the interface separately, use its exact HTTPS origin here.
# FRONTEND_URL=https://app.example.com
NODE_ENV=development
# Fictional identities only. Server refuses preview outside loopback/development.
LOCAL_PREVIEW=false
SESSION_KEY=
TOKEN_ENCRYPTION_KEY=
DATA_DIR=./data
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
DISCORD_ADMIN_ROLE_IDS=
# Register exactly APP_URL/api/auth/discord/callback in Discord.
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
# Browser always connects through the policy gateway at APP_URL.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEMBERSHIP_CACHE_SECONDS=60
MEMBERSHIP_RECHECK_SECONDS=60
MEMBERSHIP_MAX_STALE_SECONDS=300
